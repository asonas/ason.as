<!DOCTYPE html>
<html lang="ja">
<head>
<title><%= escape_html(current_page.data.title || "ason.as") %></title>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="light dark">
<%= display_meta_tags %>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
<link rel="stylesheet" href="/stylesheets/site.css">
<!-- Google Fontsはレンダリングをブロックしないよう、印刷メディアとして読み込んでから全メディアへ切り替える。JS無効環境向けにnoscriptで通常読み込みも残す。 -->
<% fonts_href = "https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,800&amp;family=JetBrains+Mono:wght@400;600&amp;family=Zen+Kaku+Gothic+New:wght@400;700&amp;display=swap" %>
<link rel="stylesheet" href="<%= fonts_href %>" media="print" onload="this.media='all'">
<noscript>
<link rel="stylesheet" href="<%= fonts_href %>">
</noscript>
<link rel="author" href="http://www.hatena.ne.jp/asonas/">
<meta name="Hatena::Bookmark" content="nocomment">
</head>
<body>
<%= yield %>
<footer class="wrap">
<div class="site-footer">
<p><a href="/">asonas a.k.a Yuya Fujiwara</a></p>
</div>
</footer>
</body>
</html>
