#!/usr/bin/env ruby
# frozen_string_literal: true

# articles/*.md を weblog.ason.as の bin/import-external-articles が読む manifest に変換する。
# 使い方: bin/export-weblog-manifest OUTPUT_DIR
# OUTPUT_DIR に manifest.json と、画像のアップロード対応表 images.tsv（元ファイル、S3 キー、Content-Type）を書く。

require "cgi"
require "digest"
require "fileutils"
require "json"
require "open3"
require "time"
require "yaml"

ROOT = File.expand_path("..", __dir__)
WEBLOG_ORIGIN = "https://weblog.ason.as"

# 埋め込みスクリプトの data-id から資料の URL は引けないため、Speaker Deck の player ページで調べた対応を持つ
SPEAKER_DECK_URLS = {
  "1c05e4592a734bbdb47329ee5eb3b9cb" => "https://speakerdeck.com/nay3/the-better-rubocop-world-to-enjoy-ruby",
  "eaf0fc068950480ca96a674fe601bc69" => "https://speakerdeck.com/asonas/how-to-make-the-groovebox",
}.freeze

CONTENT_TYPES = { "jpg" => "image/jpeg", "jpeg" => "image/jpeg", "png" => "image/png" }.freeze

# weblog の画像キーと同じ UUID の形にしつつ、再実行しても同じキーになるようファイル名から決める
def asset_uuid(filename)
  hex = Digest::SHA256.hexdigest("ason.as/images/articles/#{filename}")[0, 32]
  hex[12] = "5"
  hex[16] = ((hex[16].to_i(16) & 0x3) | 0x8).to_s(16)
  [hex[0, 8], hex[8, 4], hex[12, 4], hex[16, 4], hex[20, 12]].join("-")
end

def asset_key(filename, published)
  ext = File.extname(filename).delete_prefix(".").downcase
  ext = "jpg" if ext == "jpeg"
  format("assets/uploads/%<year>04d/%<month>02d/%<uuid>s.%<ext>s", year: published.year, month: published.month,
                                                                    uuid: asset_uuid(filename), ext:)
end

def own_line(url)
  "\n#{url}\n"
end

def convert_embeds(body, slug)
  body = body.gsub(%r{<blockquote class="twitter-tweet".*?</blockquote>}m) do |block|
    urls = block.scan(%r{https://(?:twitter|x)\.com/[A-Za-z0-9_]+/status/\d+}).uniq
    raise "#{slug}: tweet URL not found" if urls.empty?

    own_line(urls.last.sub("https://twitter.com/", "https://x.com/"))
  end
  body = body.gsub(%r{<blockquote class="instagram-media".*?</blockquote>}m) do |block|
    url = block[%r{https://www\.instagram\.com/p/[A-Za-z0-9_-]+/}] or raise "#{slug}: instagram URL not found"
    own_line(url)
  end
  body = body.gsub(%r{<iframe[^>]*amazon-adsystem\.com[^>]*>\s*</iframe>}m) do |block|
    asin = block[/asins=([A-Z0-9]+)/, 1] or raise "#{slug}: ASIN not found"
    own_line("https://www.amazon.co.jp/dp/#{asin}")
  end
  body = body.gsub(%r{<iframe[^>]*open\.spotify\.com/embed/(track|album|playlist)/([A-Za-z0-9]+)[^>]*>\s*</iframe>}m) do
    own_line("https://open.spotify.com/#{Regexp.last_match(1)}/#{Regexp.last_match(2)}")
  end
  body = body.gsub(%r{<script src="https://gist\.github\.com/([^"]+)\.js"></script>}) do
    own_line("https://gist.github.com/#{Regexp.last_match(1)}")
  end
  body = body.gsub(%r{<script[^>]*class="speakerdeck-embed"[^>]*data-id="(\h+)"[^>]*></script>}) do
    id = Regexp.last_match(1)
    own_line(SPEAKER_DECK_URLS.fetch(id) { raise "#{slug}: unknown Speaker Deck id #{id}" })
  end
  # ason.as の [embed:] は YouTube を動画にしていた。weblog で動画になるのは URL だけの行
  body = body.gsub(%r{\[embed:(https://(?:www\.)?(?:youtube\.com|youtu\.be)/[^\]\s]+)\]}) do
    own_line(Regexp.last_match(1))
  end
  body = body.gsub(%r{<cite>(.*?)</cite>}m, '\1')
  body.gsub(%r{<script[^>]*(?:platform\.(?:twitter|x)\.com|instagram\.com/embed\.js)[^>]*>\s*</script>}, "")
end

# コードブロックの中の HTML（記事中のサンプルコード）は変換も検査もしない
def outside_code(body)
  parts = body.split(/^(```.*?^```[^\n]*$)/m)
  parts.each_with_index.map { |part, index| index.odd? ? part : yield(part) }.join
end

# weblog はどのタグもエスケープして表示するので、タグ名を限らずに探す。`<https://...>` の自動リンクとインラインコードは除く
def remaining_html(body)
  found = []
  outside_code(body) do |part|
    found.concat(part.gsub(/`[^`\n]*`/, "").scan(%r{</?[A-Za-z][A-Za-z0-9-]*(?:\s[^>]*)?/?>}))
    part
  end
  found
end

def front_matter(raw, slug)
  match = raw.match(/\A---\n(.*?)\n---\n/m) or raise "#{slug}: front matter not found"
  # date はタイムゾーン無しの JST。YAML に読ませると UTC として解釈されるので文字列のまま取り出す
  date = match[1][/^date:\s*(.+)$/, 1].to_s.strip.delete('"')
  meta = YAML.safe_load(match[1].gsub(/^date:.*$/, ""))
  [meta, Time.strptime("#{date} +0900", "%Y-%m-%d %H:%M:%S %z"), match.post_match]
end

def last_commit_time(path)
  output, status = Open3.capture2("git", "-C", ROOT, "log", "-1", "--format=%aI", "--", path)
  raise "git log failed for #{path}" unless status.success? && !output.strip.empty?

  Time.iso8601(output.strip)
end

def utc(time)
  time.utc.iso8601(6)
end

output_dir = ARGV.fetch(0) { abort "usage: bin/export-weblog-manifest OUTPUT_DIR" }
FileUtils.mkdir_p(output_dir)

images = {}
problems = []
articles = Dir.glob(File.join(ROOT, "articles/*.md")).sort.map do |path|
  slug = File.basename(path, ".md")
  meta, published, body = front_matter(File.read(path), slug)
  updated = [last_commit_time("articles/#{slug}.md"), published].max

  body = outside_code(body) do |part|
    part = part.gsub(%r{\]\((?:\.\./source|/static)/images/articles/([^)\s]+)\)}) do
      file = Regexp.last_match(1)
      images[file] ||= asset_key(file, published)
      "](/#{images[file]})"
    end
    part = part.gsub(%r{https://ason\.as/articles/([A-Za-z0-9_-]+)}) { "#{WEBLOG_ORIGIN}/#{Regexp.last_match(1)}" }
    convert_embeds(part, slug).gsub(/\n{3,}/, "\n\n")
  end.strip + "\n"

  leftover = remaining_html(body)
  problems << "#{slug}: #{leftover.uniq.join(' ')}" unless leftover.empty?
  problems << "#{slug}: image outside /assets/" if body.match?(%r{!\[[^\]]*\]\((?!/assets/)})

  cover_mode = "auto"
  cover = nil
  ogp = meta["ogp_image"]
  if ogp
    file = ogp[%r{images/articles/([^/]+)\z}, 1] or raise "#{slug}: unexpected ogp_image #{ogp}"
    images[file] ||= asset_key(file, published)
    cover_mode = "explicit"
    cover = "/#{images[file]}"
  end

  {
    "slug" => slug,
    "display_title" => meta.fetch("title").to_s,
    "body" => body,
    "created_at" => utc(published),
    "updated_at" => utc(updated),
    "published_at" => utc(published),
    "cover_mode" => cover_mode,
    "cover_image_url" => cover,
  }
end

abort "Unconverted content:\n#{problems.join("\n")}" unless problems.empty?

images.each_key do |file|
  abort "missing image: #{file}" unless File.exist?(File.join(ROOT, "source/images/articles", file))
end

manifest = { "format" => 1, "site_url" => WEBLOG_ORIGIN, "source" => "ason.as", "articles" => articles }
File.write(File.join(output_dir, "manifest.json"), JSON.pretty_generate(manifest) + "\n")
File.write(File.join(output_dir, "images.tsv"), images.map do |file, key|
  ext = File.extname(file).delete_prefix(".").downcase
  [File.join(ROOT, "source/images/articles", file), key, CONTENT_TYPES.fetch(ext)].join("\t")
end.join("\n") + "\n")
puts "#{articles.length} articles, #{images.length} images -> #{output_dir}"
